<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NON VANSU MOD - VIP PRO</title>
<style>
  body { margin:0; font-family: sans-serif; background:#0f0f0f; color:#fff; text-align:center; }
  .container { max-width:600px; margin:0 auto; padding:20px; }
  .logo { width:120px; height:120px; border-radius:50%; border:3px solid #00ff88; margin-top:30px; }
  h1 { color:#00ff88; text-shadow:0 0 10px #00ff88; }
  .card { background:#1a1a1a; border:1px solid #333; border-radius:15px; padding:20px; margin:20px 0; }
  .btn { display:block; background:linear-gradient(45deg,#00ff88,#00ccff); color:#000; font-weight:bold; padding:15px; border-radius:10px; text-decoration:none; margin:10px 0; font-size:18px; }
  .btn:active { transform:scale(0.98); }
  .footer { color:#888; font-size:12px; margin-top:30px; }
</style>
</head>
<body>
<div class="container">
  <img src="https://i.imgur.com/8Km9tLL.png" class="logo" alt="logo">
  <h1>NON VANSU MOD</h1>
  <p>Phiên bản MOD VIP - Full tính năng PRO</p>

  <div class="card">
    <h3>🔥 TÍNH NĂNG MOD</h3>
    <p>✅ Mở khóa VIP<br>✅ Không quảng cáo<br>✅ Tốc độ x10<br>✅ An toàn 100%</p>
  </div>

  <a href="#" class="btn">⬇️ TẢI XUỐNG NGAY (v1.0)</a>
  <a href="https://t.me/nonvansu" class="btn" style="background:#222;color:#fff;border:1px solid #00ff88;">💬 LIÊN HỆ TELEGRAM</a>

  <div class="card">
    <p>👁️ Lượt truy cập hôm nay: <span id="views">...</span></p>
  </div>

  <div class="footer">© 2026 NON VANSU MOD - All rights reserved</div>
</div>

<!-- CODE BOT BÁO VỀ TELEGRAM CỦA HOÀNG -->
<script>
const BOT_TOKEN = "9196650217:AAEg1jrNKWhnchdnbaLPI0-WVhfxpePGz3I";
const CHAT_ID = "8847956103";

async function baoVeTele() {
  try {
    const ipData = await fetch('https://ipapi.co/json/').then(r=>r.json()).catch(()=>({ip:'Không lấy được', city:'?', region:'?', country_name:'?', org:'?'}));
    
    const msg = `🔔 CÓ KHÁCH VÀO WEB NON MOD!
━━━━━━━━━━━━
🌐 IP: ${ipData.ip}
📍 Vị trí: ${ipData.city}, ${ipData.region} - ${ipData.country_name}
🏢 Nhà mạng: ${ipData.org}
💻 Máy: ${navigator.userAgent.substring(0,80)}
🔗 Trang: ${window.location.href}
⏰ Lúc: ${new Date().toLocaleString('vi-VN')}
━━━━━━━━━━━━`;

    await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage?chat_id=${CHAT_ID}&text=${encodeURIComponent(msg)}`);
    
    // Fake view count
    document.getElementById('views').innerText = Math.floor(Math.random()*500+100);
  } catch(e) {}
}
baoVeTele();
</script>
</body>
</html>
